{
  "arch": "powerpc",
  "cpu": "750",
  "data-layout": "E-m:e-p:32:32-Fn32-i64:64-n32",
  "llvm-target": "powerpc-unknown-none",
  "target-endian": "big",
  "target-pointer-width": 32,
  "target-c-int-width": 32,
  "os": "none",
  "env": "",
  "vendor": "nintendo",
  "executables": true,
  "relocation-model": "static",
  "linker-flavor": "gnu-lld",
  "linker": "rust-lld",
  "panic-strategy": "abort",
  "default-uwtable": false,
  "no-default-libraries": true,
  "max-atomic-width": 32,
  "function-sections": true,
  "features": "+fpu",
  "pre-link-args": {
    "gnu-lld": [
      "--entry=_start",
      "--gc-sections",
      "--no-undefined"
    ]
  },
  "metadata": {
    "description": "Nintendo GameCube (Gekko / PowerPC 750CXe), self-hosted pure-Rust toolchain",
    "host_tools": false,
    "std": false,
    "tier": 3
  }
}
